  "get_filename_component(AILO_SOURCE_ROOT \"\${CMAKE_CURRENT_LIST_DIR}/..\" ABSOLUTE)\nset(CMAKE_C_COMPILER \"\${AILO_SOURCE_ROOT}/cc\")\nset(CMAKE_CXX_COMPILER \"\${AILO_SOURCE_ROOT}/cxx\")\n")
set(identity_header "${identity_root}/.cache/deps-build/x86_64-linux-gnu/mesa/source/include/ailo_mesa_build_id.h")
foreach(iteration RANGE 1 3)
  execute_process(COMMAND "${CMAKE_COMMAND}" -DAILO_TARGET_ID=x86_64-linux-gnu
    -P "${identity_root}/cmake/AiloMesaIdentity.cmake" COMMAND_ERROR_IS_FATAL ANY)
  file(SHA256 "${identity_header}" actual)
  file(TIMESTAMP "${identity_header}" stamp "%s.%f")
  if(iteration EQUAL 1)
    set(original "${actual}")
    set(original_stamp "${stamp}")
    file(READ "${identity_header}" header)
    string(REGEX MATCH "AILO_ANV_BUILD_ID_HEX \"([0-9a-f]+)\"" match "${header}")
    set(anv "${CMAKE_MATCH_1}")
    string(REGEX MATCH "AILO_RADV_BUILD_ID_HEX \"([0-9a-f]+)\"" match "${header}")
    if(anv STREQUAL CMAKE_MATCH_1 OR anv STREQUAL "")
      message(FATAL_ERROR "Static drivers do not have distinct embedded identities")
    endif()
  elseif(iteration EQUAL 2)
    if(NOT actual STREQUAL original OR NOT stamp STREQUAL original_stamp)
      message(FATAL_ERROR "Unchanged Mesa inputs regenerated the build identity")
    endif()
    file(WRITE "${identity_root}/cxx" "changed compiler identity\n")
  elseif(actual STREQUAL original)
    message(FATAL_ERROR "Changed compiler did not invalidate Mesa build identity")
  endif()
endforeach()
