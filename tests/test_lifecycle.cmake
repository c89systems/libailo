cmake_minimum_required(VERSION 3.24)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${root}/cmake/dependencies.json" pins)
foreach(component cpkt cpktmisc lonejson pslog)
  string(JSON upstream GET "${pins}" "${component}" upstream)
  set(repository "${component}")
  if(component STREQUAL "pslog")
    set(repository libpslog)
  endif()
  if((component MATCHES "^(lonejson|pslog)$" AND NOT upstream STREQUAL "https://github.com/sa6mwa/${repository}") OR
     (NOT component MATCHES "^(lonejson|pslog)$" AND NOT upstream STREQUAL "https://github.com/c89systems/${component}"))
    message(FATAL_ERROR "${component}: wrong declared upstream")
  endif()
  string(JSON count LENGTH "${pins}" "${component}" assets)
  if(NOT count EQUAL 5)
    message(FATAL_ERROR "${component}: missing a target SDK pin")
  endif()
  foreach(target x86_64-linux-gnu x86_64-linux-musl aarch64-linux-gnu aarch64-linux-musl arm64-apple-darwin)
    string(JSON sha GET "${pins}" "${component}" assets "${target}" sha256)
    string(JSON url GET "${pins}" "${component}" assets "${target}" url)
    string(LENGTH "${sha}" length)
    if(NOT length EQUAL 64 OR NOT sha MATCHES "^[0-9a-f]+$" OR NOT url MATCHES "^https://")
      message(FATAL_ERROR "${component}/${target}: invalid dependency pin")
    endif()
  endforeach()
endforeach()
execute_process(COMMAND make help WORKING_DIRECTORY "${root}"
  RESULT_VARIABLE result OUTPUT_VARIABLE help)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "make help failed")
endif()
foreach(command lua-build lua-test package-lua deps build test format upstream-inventory valgrind valgrind-model valgrind-acquisition inference-smoke-vulkan test-install-tree print-release-version package-source package-source-smoke test-source-archive package package-checksums package-verify release-matrix test-scalar-matrix example-smoke-local)
  if(NOT help MATCHES "(^|\n)${command}[ \r\n]")
    message(FATAL_ERROR "make help omits ${command}")
  endif()
endforeach()
file(READ "${root}/CMakePresets.json" presets)
string(JSON count LENGTH "${presets}" configurePresets)
math(EXPR last "${count} - 1")
set(names "")
set(releases 0)
foreach(index RANGE 0 ${last})
  string(JSON name GET "${presets}" configurePresets ${index} name)
  list(APPEND names "${name}")
  if(name MATCHES "-release$")
    math(EXPR releases "${releases} + 1")
  endif()
endforeach()
foreach(name base debug cpu valgrind library)
  if(NOT name IN_LIST names)
    message(FATAL_ERROR "Missing required preset: ${name}")
  endif()
endforeach()
if(NOT releases EQUAL 4)
  message(FATAL_ERROR "Linux release target matrix is incomplete")
endif()
file(READ "${root}/.gitignore" ignores)
if(NOT ignores MATCHES "(^|\n)/build/(\n|$)")
  message(FATAL_ERROR "Generated workspaces are not ignored")
endif()
execute_process(COMMAND "${root}/scripts/cpkt-toolchains.sh" discover x86_64-linux-gnu
  RESULT_VARIABLE result OUTPUT_VARIABLE description)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect selected toolchain")
endif()
foreach(key cc cxx readelf sysroot root)
  string(REGEX MATCH "(^|\n)${key}=([^\r\n]+)" match "${description}")
  if(NOT match)
    message(FATAL_ERROR "Resolver omitted ${key}")
  endif()
  set(collection_${key} "${CMAKE_MATCH_2}")
endforeach()
file(READ "${AILO_BUILD_DIRECTORY}/CMakeCache.txt" cache)
foreach(pair "C_COMPILER;cc" "CXX_COMPILER;cxx")
  list(GET pair 0 entry)
  list(GET pair 1 key)
  string(REGEX MATCH "(^|\n)CMAKE_${entry}:[^=]+=([^\r\n]+)" match "${cache}")
  if(NOT CMAKE_MATCH_2 STREQUAL collection_${key})
    message(FATAL_ERROR "Native build selected the wrong ${entry}")
  endif()
endforeach()
set(executable "${AILO_BUILD_DIRECTORY}/ailo_backend_test")
execute_process(COMMAND "${collection_readelf}" -l "${executable}"
  RESULT_VARIABLE result OUTPUT_VARIABLE metadata)
string(REGEX MATCH "Requesting program interpreter: ([^]]+)" match "${metadata}")
set(loader "${CMAKE_MATCH_1}")
string(FIND "${loader}" "${collection_sysroot}/lib/ld-linux" inside)
if(NOT result EQUAL 0 OR NOT inside EQUAL 0)
  message(FATAL_ERROR "Native executable selected the wrong libc loader")
endif()
execute_process(COMMAND "${loader}" --list "${executable}"
  RESULT_VARIABLE result OUTPUT_VARIABLE loaded ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Native runtime object inspection failed: ${error}")
endif()
foreach(library libc.so.6 libm.so.6 libstdc++.so.6 libgcc_s.so.1)
  string(REPLACE "." "\\." pattern "${library}")
  string(REPLACE "+" "\\+" pattern "${pattern}")
  string(REGEX MATCH "${pattern} => ([^ \r\n]+)" match "${loaded}")
  string(FIND "${CMAKE_MATCH_1}" "${collection_root}/" inside)
  if(NOT match OR NOT inside EQUAL 0)
    message(FATAL_ERROR "Native ${library} escaped the selected compiler collection: ${loaded}")
  endif()
endforeach()
if(AILO_TEST_VULKAN)
  set(helper "${root}/.cache/deps-build/x86_64-linux-gnu/llama/build/ggml/src/ggml-vulkan/vulkan-shaders-gen-prefix/src/vulkan-shaders-gen-build/CMakeCache.txt")
  file(READ "${helper}" helper_cache)
  foreach(pair "C_COMPILER;cc" "CXX_COMPILER;cxx")
    list(GET pair 0 entry)
    list(GET pair 1 key)
    string(REGEX MATCH "(^|\n)CMAKE_${entry}:[^=]+=([^\r\n]+)" match "${helper_cache}")
    if(NOT CMAKE_MATCH_2 STREQUAL collection_${key})
      message(FATAL_ERROR "Shader helper selected the wrong ${entry}")
    endif()
  endforeach()
endif()
execute_process(COMMAND "${executable}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Direct native execution failed")
endif()
message(STATUS "Lifecycle pins, command surface and loaded native compiler runtimes: passed")
