cmake_minimum_required(VERSION 3.24)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 random)
set(work "${root}/build/tests/privacy-${random}")
file(MAKE_DIRECTORY "${work}/stage/sdk/include/ailo" "${work}/stage/sdk/lib" "${work}/stage/sdk/share")
file(WRITE "${work}/stage/sdk/share/portable.txt" "Logical package metadata only\n")
function(check_payload label expected diagnostic)
  set(extracted "${work}/${label}")
  file(MAKE_DIRECTORY "${extracted}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${work}/${label}.tar.gz" sdk
    WORKING_DIRECTORY "${work}/stage" COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${work}/${label}.tar.gz"
    WORKING_DIRECTORY "${extracted}" COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "${root}/scripts/verify_install_privacy.sh" "${extracted}/sdk" "${AILO_READELF}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL expected OR NOT "${output}${error}" MATCHES "${diagnostic}")
    message(FATAL_ERROR "Extracted privacy fixture ${label}: ${result}, expected ${expected}: ${output}${error}")
  endif()
endfunction()
check_payload(clean 0 "passed")
file(MAKE_DIRECTORY "${work}/stage/sdk/lib/ailo/native")
file(WRITE "${work}/stage/sdk/lib/ailo/native/forbidden.so" "external GPU code is forbidden\n")
check_payload(native-shared-object 1 "static archives only")
file(REMOVE "${work}/stage/sdk/lib/ailo/native/forbidden.so")
foreach(pair "repository;${root}/src/private.c" "home;$ENV{HOME}/private.txt" "file-url;file://$ENV{HOME}/secret" "foreign-home;/home/another-engineer/private/artifact")
  list(GET pair 0 label)
  list(GET pair 1 value)
  file(WRITE "${work}/stage/sdk/share/leak.txt" "${value}\n")
  check_payload("${label}" 1 "leak.txt")
endforeach()
file(REMOVE "${work}/stage/sdk/share/leak.txt")
file(WRITE "${work}/leak.c" "const char *fixture_path(void) { return \"${root}/private/source.c\"; }\n")
execute_process(COMMAND "${AILO_CC}" "--sysroot=${AILO_SYSROOT}" -std=c89 -Wall -Wextra -Wpedantic -Werror -fPIC -shared -Wl,--fatal-warnings
  "${work}/leak.c" -o "${work}/stage/sdk/lib/libleak.so" COMMAND_ERROR_IS_FATAL ANY)
check_payload(binary 1 "libleak.so")
file(REMOVE "${work}/stage/sdk/lib/libleak.so")
file(WRITE "${work}/clean.c" "int fixture_value(void) { return 7; }\n")
execute_process(COMMAND "${AILO_CC}" "--sysroot=${AILO_SYSROOT}" -std=c89 -Wall -Wextra -Wpedantic -Werror -fPIC -shared -Wl,--fatal-warnings
  -Wl,-rpath,/opt/private-runtime "${work}/clean.c" -o "${work}/stage/sdk/lib/librpath.so" COMMAND_ERROR_IS_FATAL ANY)
check_payload(absolute-rpath 1 "runtime path.*librpath.so")
file(REMOVE "${work}/stage/sdk/lib/librpath.so")
file(CREATE_LINK "/opt/private-runtime/libsecret.so" "${work}/stage/sdk/lib/libescape.so" SYMBOLIC)
check_payload(symlink 1 "symlink.*libescape.so")
file(REMOVE "${work}/stage/sdk/lib/libescape.so")
execute_process(COMMAND "${AILO_CC}" "--sysroot=${AILO_SYSROOT}" -std=c89 -Wall -Wextra -Wpedantic -Werror -fPIC -shared -Wl,--fatal-warnings
  "-Wl,-rpath,$ORIGIN/native" "${work}/clean.c" -o "${work}/stage/sdk/lib/libportable.so" COMMAND_ERROR_IS_FATAL ANY)
check_payload(relative-rpath 0 "passed")
file(REMOVE_RECURSE "${work}")
message(STATUS "Extracted text/binary leaks, absolute runtime paths and escaping symlinks are rejected")
