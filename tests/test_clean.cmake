cmake_minimum_required(VERSION 3.24)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(work "${root}/build/tests/clean")
foreach(directory build dist .cache)
  file(MAKE_DIRECTORY "${work}/${directory}/.hidden")
  file(WRITE "${work}/${directory}/.hidden/marker" "generated")
endforeach()
file(MAKE_DIRECTORY "${work}/global")
file(WRITE "${work}/global/marker" "preserved")
execute_process(COMMAND make -f "${root}/Makefile" clean WORKING_DIRECTORY "${work}"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "clean failed: ${error}")
endif()
foreach(directory build dist .cache)
  if(EXISTS "${work}/${directory}")
    message(FATAL_ERROR "clean retained ${directory}")
  endif()
endforeach()
if(NOT EXISTS "${work}/global/marker")
  message(FATAL_ERROR "clean removed an unrelated cache")
endif()
