cmake_minimum_required(VERSION 3.24)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(work "${root}/build/tests/cache-defaults")
file(MAKE_DIRECTORY "${work}")
file(WRITE "${work}/inspect.cmake" "include(\"${root}/cmake/AiloArchive.cmake\")\nfile(WRITE \"${work}/result\" \"\${CPKT_DEPENDENCY_CACHE}\")\n")
file(WRITE "${work}/run.cmake" "if(CPKT_TEST_XDG)\n  set(ENV{XDG_CACHE_HOME} \"\${CPKT_TEST_XDG}\")\nendif()\nif(CPKT_TEST_EXPLICIT)\n  set(ENV{CPKT_DEPENDENCY_CACHE} \"\${CPKT_TEST_EXPLICIT}\")\nendif()\ninclude(\"${work}/inspect.cmake\")\n")
foreach(mode home xdg explicit)
  set(expected "${work}/home/.cache/cpkt/deps")
  set(xdg "")
  set(explicit "")
  if(mode STREQUAL "xdg")
    set(xdg "${work}/xdg")
    set(expected "${xdg}/cpkt/deps")
  elseif(mode STREQUAL "explicit")
    set(explicit "${work}/override")
    set(expected "${explicit}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=XDG_CACHE_HOME --unset=CPKT_DEPENDENCY_CACHE
    "HOME=${work}/home" "${CMAKE_COMMAND}" "-DCPKT_TEST_XDG=${xdg}" "-DCPKT_TEST_EXPLICIT=${explicit}"
    -P "${work}/run.cmake" RESULT_VARIABLE result ERROR_VARIABLE error)
  # The runner below supplies only the selected nonempty environment values.
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cache default ${mode}: ${error}")
  endif()
  file(READ "${work}/result" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Cache default ${mode}: expected ${expected}; actual ${actual}")
  endif()
endforeach()
