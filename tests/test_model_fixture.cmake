cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED AILO_FIXTURE_WRITER OR NOT DEFINED AILO_MODEL_FIXTURE)
  message(FATAL_ERROR "Model fixture check requires a writer and output path")
endif()
set(expected "e32806b9651b70b20c6109e4f4aab9e8ef0099108b69a1214e937f8ef1a77668")
foreach(iteration RANGE 1 2)
  execute_process(COMMAND "${AILO_FIXTURE_WRITER}" "${AILO_MODEL_FIXTURE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Model fixture writer failed (${result}): ${output}${error}")
  endif()
  file(SHA256 "${AILO_MODEL_FIXTURE}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Deterministic model bytes changed: ${actual}, expected ${expected}")
  endif()
  set(split_digests "3727b69e17e9d08f2f9ccf5d5277b8dc49b32faf111b4856cc8a3e5984f42f58" "3fdbd95755b1ce1dcea528be776714517a832c5bdb9830015cf601320bcde089")
  foreach(index RANGE 0 1)
    math(EXPR shard "${index} + 1")
    list(GET split_digests ${index} split_expected)
    file(SHA256 "${AILO_MODEL_FIXTURE}-0000${shard}-of-00002.gguf" actual)
    if(NOT actual STREQUAL split_expected)
      message(FATAL_ERROR "Deterministic split GGUF bytes changed: ${actual}, expected ${split_expected}")
    endif()
  endforeach()
endforeach()
message(STATUS "Repeated fixture writes match pinned SHA-256 ${expected}")
