#version 450
layout(constant_id=0) const uint SLOTS=128;
layout(local_size_x_id=1, local_size_y=1, local_size_z=1) in;
layout(binding=0) writeonly buffer Result { uint errors[]; };
layout(push_constant) uniform Parameters { uint seed; } p;
shared uint a[SLOTS];
shared uint b[SLOTS];
uint tag(uint j, uint round) {
    return (j*0x9e3779b9u)^gl_WorkGroupID.x^(round*0x1234567u)^p.seed;
}
void main() {
    uint lane=gl_LocalInvocationID.x;
    uint bad=0;
    for(uint round=0;round<8;round++) {
        for(uint j=lane;j<SLOTS;j+=gl_WorkGroupSize.x) {
            uint v=tag(j,round);
            a[j]=v;
            b[j]=~v;
        }
        barrier();
        for(uint k=0;k<32;k++) {
            uint j=(lane*17+k*31)&(SLOTS-1);
            uint v=tag(j,round);
            bad|=a[j]^v;
            bad|=b[j]^~v;
        }
        barrier();
    }
    errors[gl_GlobalInvocationID.x]=bad;
}
