include(GNUInstallDirs)
include(CMakePackageConfigHelpers)
option(AILO_INSTALL "Install the C89 library and its separate native link closure" ON)
if(NOT AILO_INSTALL)
  return()
endif()
if(NOT AILO_BUILD_STATIC AND NOT AILO_BUILD_SHARED)
  message(FATAL_ERROR "AILO_INSTALL requires a project library target")
endif()
if(NOT CMAKE_INSTALL_LIBDIR STREQUAL "lib" OR NOT CMAKE_INSTALL_INCLUDEDIR STREQUAL "include")
  message(FATAL_ERROR "Ailo SDK layout requires lib/ and include/ for every target")
endif()
set(ailo_native_targets llama ggml ggml-base ggml-cpu mtmd vendor-hash)
if(AILO_VULKAN)
  list(APPEND ailo_native_targets ggml-vulkan)
endif()
set(AILO_NATIVE_NAMES "")
foreach(target IN LISTS ailo_native_targets)
  if(NOT TARGET ${target})
    message(FATAL_ERROR "Missing native SDK archive target: ${target}")
  endif()
  string(APPEND AILO_NATIVE_NAMES "${target};")
  install(FILES "$<TARGET_FILE:${target}>" DESTINATION lib/ailo/native COMPONENT ailo)
endforeach()
set(AILO_NATIVE_NAMES "${ailo_native_targets}")
foreach(target ailo_static ailo_shared)
  if(TARGET ${target})
    set_target_properties(${target} PROPERTIES INSTALL_RPATH "$ORIGIN/ailo/native" INSTALL_RPATH_USE_LINK_PATH FALSE)
    install(TARGETS ${target} ARCHIVE DESTINATION lib COMPONENT ailo LIBRARY DESTINATION lib COMPONENT ailo)
  endif()
endforeach()

# Runtime archives stay separate from the facade and come from the same complete
# compiler collection used to build it. Do not package a host fallback.
set(AILO_RUNTIME_NAMES libstdc++.a libgcc_eh.a libgcc.a)
foreach(name IN LISTS AILO_RUNTIME_NAMES)
  execute_process(COMMAND "${CMAKE_CXX_COMPILER}" "-print-file-name=${name}"
    RESULT_VARIABLE result OUTPUT_VARIABLE archive OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT result EQUAL 0 OR NOT EXISTS "${archive}")
    message(FATAL_ERROR "Pinned compiler collection has no ${name}")
  endif()
  file(REAL_PATH "${archive}" archive)
  string(FIND "${archive}" "${AILO_BOOTLIN_ROOT}/" inside)
  if(NOT inside EQUAL 0)
    message(FATAL_ERROR "SDK runtime archive escaped the pinned collection: ${name}")
  endif()
  install(FILES "${archive}" DESTINATION lib/ailo/runtime RENAME "${name}" COMPONENT ailo)
endforeach()
if(AILO_VULKAN)
  file(GLOB vulkan_libraries "${AILO_DEPENDENCY_ROOT}/vulkan-loader/install/lib/libvulkan.so*")
  if(NOT vulkan_libraries)
    message(FATAL_ERROR "Vulkan SDK requires the pinned loader libraries")
  endif()
  install(FILES ${vulkan_libraries} DESTINATION lib/ailo/native COMPONENT ailo)
  install(FILES "${AILO_DEPENDENCY_BUILD_ROOT}/vulkan-loader/source/LICENSE.txt" DESTINATION share/ailo/licenses RENAME vulkan-loader.txt COMPONENT ailo)
endif()
install(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/include/ailo" DESTINATION include COMPONENT ailo FILES_MATCHING PATTERN "*.h")
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/LICENSE" "${CMAKE_CURRENT_SOURCE_DIR}/README.md" DESTINATION share/doc/ailo COMPONENT ailo)
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/examples/scalars.c" "${CMAKE_CURRENT_SOURCE_DIR}/examples/model_cache.c" DESTINATION share/doc/ailo/examples COMPONENT ailo)
install(FILES "${AILO_DEPENDENCY_BUILD_ROOT}/llama/source/LICENSE" DESTINATION share/ailo/licenses RENAME llama.txt COMPONENT ailo)
install(FILES "${AILO_DEPENDENCY_BUILD_ROOT}/llama/source/vendor/hash/xxhash/LICENSE" DESTINATION share/ailo/licenses RENAME xxhash.txt COMPONENT ailo)
install(FILES "${AILO_DEPENDENCY_BUILD_ROOT}/llama/source/vendor/hash/sha256/LICENSE" DESTINATION share/ailo/licenses RENAME sha256.txt COMPONENT ailo)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/vendor/licenses/sources.json" license_sources)
string(JSON count LENGTH "${license_sources}")
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
  string(JSON name MEMBER "${license_sources}" ${index})
  string(JSON expected GET "${license_sources}" "${name}" sha256)
  file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/vendor/licenses/${name}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "SDK license snapshot differs from its recorded source: ${name}")
  endif()
endforeach()
install(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/vendor/licenses/" DESTINATION share/ailo/licenses COMPONENT ailo FILES_MATCHING PATTERN "*.txt" PATTERN "gcc-COPYING*" PATTERN "sources.json")

configure_package_config_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/ailoConfig.cmake.in"
  "${CMAKE_CURRENT_BINARY_DIR}/install/ailoConfig.cmake" INSTALL_DESTINATION lib/cmake/ailo)
write_basic_package_version_file("${CMAKE_CURRENT_BINARY_DIR}/install/ailoConfigVersion.cmake" VERSION "${PROJECT_VERSION}" COMPATIBILITY SameMajorVersion)
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/install/ailoConfig.cmake" "${CMAKE_CURRENT_BINARY_DIR}/install/ailoConfigVersion.cmake" DESTINATION lib/cmake/ailo COMPONENT ailo)
set(AILO_NATIVE_PC "")
# Resolve archive ordering through one linker group; metadata owns the closure.
foreach(name IN LISTS ailo_native_targets)
  string(APPEND AILO_NATIVE_PC " -l:lib${name}.a")
endforeach()
set(AILO_RUNTIME_PC "")
foreach(name IN LISTS AILO_RUNTIME_NAMES)
  string(APPEND AILO_RUNTIME_PC " -l:${name}")
endforeach()
set(AILO_VULKAN_PC "")
if(AILO_VULKAN)
  set(AILO_VULKAN_PC " -L\${prefix}/lib/ailo/native -lvulkan")
endif()
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/ailo.pc.in" "${CMAKE_CURRENT_BINARY_DIR}/install/ailo.pc" @ONLY)
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/ailo-static.pc.in" "${CMAKE_CURRENT_BINARY_DIR}/install/ailo-static.pc" @ONLY)
if(AILO_BUILD_SHARED)
  install(FILES "${CMAKE_CURRENT_BINARY_DIR}/install/ailo.pc" DESTINATION lib/pkgconfig COMPONENT ailo)
endif()
if(AILO_BUILD_STATIC)
  install(FILES "${CMAKE_CURRENT_BINARY_DIR}/install/ailo-static.pc" DESTINATION lib/pkgconfig COMPONENT ailo)
endif()

file(READ "${CMAKE_CURRENT_SOURCE_DIR}/cmake/dependencies.json" pins)
string(JSON cpkt_version GET "${pins}" cpkt version)
string(JSON cpkt_url GET "${pins}" cpkt assets "${AILO_TARGET_ID}" url)
string(JSON cpkt_sha GET "${pins}" cpkt assets "${AILO_TARGET_ID}" sha256)
string(JSON llama_version GET "${pins}" llama version)
string(JSON llama_url GET "${pins}" llama url)
string(JSON llama_sha GET "${pins}" llama sha256)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/install/dependencies.json"
  "{\n  \"project\": \"ailo\", \"version\": \"${PROJECT_VERSION}\", \"target\": \"${AILO_TARGET_ID}\",\n  \"dependencies\": [\n    {\"name\": \"llama\", \"version\": \"${llama_version}\", \"url\": \"${llama_url}\", \"sha256\": \"${llama_sha}\", \"bundled\": true, \"role\": \"separate native archives\", \"license\": \"MIT with vendored notices\"},\n    {\"name\": \"c.pkt.systems\", \"version\": \"${cpkt_version}\", \"url\": \"${cpkt_url}\", \"sha256\": \"${cpkt_sha}\", \"bundled\": false, \"role\": \"curl/OpenSSL external SDK\"},\n    {\"name\": \"GNU C++ runtime\", \"version\": \"${CMAKE_CXX_COMPILER_VERSION}\", \"bundled\": true, \"role\": \"separate runtime archives\", \"license\": \"GPL-3.0-or-later WITH GCC-exception-3.1\"}\n  ]\n}\n")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/install/dependencies.json" DESTINATION share/ailo COMPONENT ailo)
if(AILO_VULKAN)
  file(READ "${CMAKE_CURRENT_BINARY_DIR}/install/dependencies.json" manifest)
  string(JSON version GET "${pins}" vulkan-loader version)
  string(JSON url GET "${pins}" vulkan-loader url)
  string(JSON sha GET "${pins}" vulkan-loader sha256)
  string(JSON manifest SET "${manifest}" dependencies 3 "{\"name\":\"Vulkan loader\",\"version\":\"${version}\",\"url\":\"${url}\",\"sha256\":\"${sha}\",\"bundled\":true,\"role\":\"native shared loader\",\"license\":\"Apache-2.0\"}")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/install/dependencies.json" "${manifest}\n")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/install/test-settings.txt" "target=${AILO_TARGET_ID}\nnm=${CMAKE_NM}\nreadelf=${CMAKE_READELF}\ntoolchain=${CMAKE_TOOLCHAIN_FILE}\n")
