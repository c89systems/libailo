cmake_minimum_required(VERSION 3.24)

if(NOT DEFINED CPKT_DEPENDENCY_CACHE)
  if(DEFINED ENV{CPKT_DEPENDENCY_CACHE})
    set(CPKT_DEPENDENCY_CACHE "$ENV{CPKT_DEPENDENCY_CACHE}")
  elseif(DEFINED ENV{XDG_CACHE_HOME})
    set(CPKT_DEPENDENCY_CACHE "$ENV{XDG_CACHE_HOME}/cpkt/deps")
  else()
    set(CPKT_DEPENDENCY_CACHE "$ENV{HOME}/.cache/cpkt/deps")
  endif()
endif()
set(CPKT_DEPENDENCY_CACHE "${CPKT_DEPENDENCY_CACHE}" CACHE PATH "Shared verified dependency archives")

function(ailo_acquire_verified_archive component url sha output)
  string(LENGTH "${sha}" length)
  if(NOT length EQUAL 64 OR NOT sha MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "${component}: missing or invalid SHA-256 pin")
  endif()
  if(NOT url MATCHES "^https://" AND NOT AILO_ARCHIVE_TEST_HTTP)
    message(FATAL_ERROR "${component}: dependency URL must use HTTPS")
  endif()
  set(dir "${CPKT_DEPENDENCY_CACHE}/archives/sha256/${sha}")
  file(MAKE_DIRECTORY "${dir}" "${CPKT_DEPENDENCY_CACHE}/locks")
  file(LOCK "${CPKT_DEPENDENCY_CACHE}/locks/${sha}.lock" GUARD FUNCTION TIMEOUT 600)
  file(GLOB candidates LIST_DIRECTORIES FALSE "${dir}/*")
  foreach(candidate IN LISTS candidates)
    if(candidate MATCHES "\\.partial-")
      continue()
    endif()
    file(SHA256 "${candidate}" actual)
    if(actual STREQUAL sha)
      set(${output} "${candidate}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  get_filename_component(name "${url}" NAME)
  string(RANDOM LENGTH 16 random)
  set(partial "${dir}/${name}.partial-${random}")
  foreach(attempt RANGE 1 3)
    file(DOWNLOAD "${url}" "${partial}" TLS_VERIFY ON TIMEOUT 600 INACTIVITY_TIMEOUT 60 STATUS status)
    list(GET status 0 result)
    if(result EQUAL 0)
      file(SHA256 "${partial}" actual)
      if(actual STREQUAL sha)
        file(RENAME "${partial}" "${dir}/${name}")
        set(${output} "${dir}/${name}" PARENT_SCOPE)
        return()
      endif()
      file(REMOVE "${partial}")
      message(FATAL_ERROR "${component}: SHA-256 mismatch; url=${url}; expected=${sha}; actual=${actual}; cache=${dir}")
    endif()
  endforeach()
  file(REMOVE "${partial}")
  message(FATAL_ERROR "${component}: download failed; url=${url}; expected=${sha}; cache=${dir}; result=${status}")
endfunction()

if(DEFINED AILO_ARCHIVE_COMPONENT)
  ailo_acquire_verified_archive("${AILO_ARCHIVE_COMPONENT}" "${AILO_ARCHIVE_URL}" "${AILO_ARCHIVE_SHA256}" archive)
  file(WRITE "${AILO_ARCHIVE_RESULT}" "${archive}\n")
endif()
