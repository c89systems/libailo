cmake_minimum_required(VERSION 3.24)
get_filename_component(AILO_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT AILO_TARGET_ID)
  set(AILO_TARGET_ID "x86_64-linux-gnu" CACHE STRING "Bootlin target")
endif()
if(NOT AILO_TARGET_ID MATCHES "^(x86_64|aarch64)-linux-(gnu|musl)$")
  message(FATAL_ERROR "Unsupported libailo target: ${AILO_TARGET_ID}; select x86_64 or aarch64 with glibc or musl")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES AILO_TARGET_ID)
execute_process(COMMAND "${AILO_SOURCE_ROOT}/scripts/cpkt-toolchains.sh" discover "${AILO_TARGET_ID}"
  RESULT_VARIABLE result OUTPUT_VARIABLE description ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Pinned Bootlin discovery failed: ${error}")
endif()
if(NOT description MATCHES "(^|\n)status=ready(\n|$)")
  message(FATAL_ERROR "Prepare the pinned collection first: scripts/cpkt-toolchains.sh ensure ${AILO_TARGET_ID}")
endif()
foreach(key cc cxx ld ar ranlib strip nm objcopy objdump addr2line readelf sysroot root)
  string(REGEX MATCH "(^|\n)${key}=([^\r\n]+)" match "${description}")
  if(NOT match)
    message(FATAL_ERROR "Bootlin resolver omitted ${key}")
  endif()
  set(bootlin_${key} "${CMAKE_MATCH_2}")
endforeach()
foreach(pair "C_COMPILER;cc" "CXX_COMPILER;cxx" "LINKER;ld" "AR;ar" "RANLIB;ranlib" "STRIP;strip" "NM;nm" "OBJCOPY;objcopy" "OBJDUMP;objdump" "ADDR2LINE;addr2line" "READELF;readelf")
  list(GET pair 0 cmake_key)
  list(GET pair 1 key)
  set(CMAKE_${cmake_key} "${bootlin_${key}}" CACHE FILEPATH "Pinned Bootlin tool" FORCE)
endforeach()
set(CMAKE_SYSROOT "${bootlin_sysroot}" CACHE PATH "Bootlin sysroot" FORCE)
set(AILO_BOOTLIN_ROOT "${bootlin_root}" CACHE PATH "Bootlin root" FORCE)
set(AILO_SDK_ROOT "${AILO_SOURCE_ROOT}/.cache/deps/${AILO_TARGET_ID}")
set(CMAKE_FIND_ROOT_PATH "${bootlin_sysroot};${bootlin_root};${AILO_SDK_ROOT}/cpkt/install;${AILO_SDK_ROOT}/cpktmisc/install;${AILO_SDK_ROOT}/lonejson/install;${AILO_SDK_ROOT}/spirv-headers/install;${AILO_SDK_ROOT}/vulkan-headers/install")
list(APPEND CMAKE_FIND_ROOT_PATH ${CMAKE_PREFIX_PATH})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
if(AILO_TARGET_ID MATCHES "^aarch64")
  set(CMAKE_SYSTEM_NAME Linux)
  set(CMAKE_SYSTEM_PROCESSOR aarch64)
endif()
