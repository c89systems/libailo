function(ailo_c89_target target)
  set_target_properties(${target} PROPERTIES C_EXTENSIONS OFF)
  target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:C>:-std=c89;-Wall;-Wextra;-Wpedantic;-pedantic-errors;-Werror>")
endfunction()

function(ailo_local_executable target)
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND DEFINED AILO_DEPENDENCY_ROOT)
    foreach(component vulkan-loader cpkt cpktmisc lonejson pslog)
      if(EXISTS "${AILO_DEPENDENCY_ROOT}/${component}/install/lib")
        target_link_options(${target} PRIVATE "-Wl,-rpath-link,${AILO_DEPENDENCY_ROOT}/${component}/install/lib")
      endif()
    endforeach()
  endif()
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT CMAKE_CROSSCOMPILING)
    ailo_native_runtime(loader paths)
    if(DEFINED AILO_DEPENDENCY_ROOT AND EXISTS "${AILO_DEPENDENCY_ROOT}/vulkan-loader/install/lib")
      list(APPEND paths "${AILO_DEPENDENCY_ROOT}/vulkan-loader/install/lib")
    endif()
    if(DEFINED AILO_DEPENDENCY_ROOT AND EXISTS "${AILO_DEPENDENCY_ROOT}/cpkt/install/lib")
      list(APPEND paths "${AILO_DEPENDENCY_ROOT}/cpkt/install/lib")
    endif()
    if(DEFINED AILO_DEPENDENCY_ROOT AND EXISTS "${AILO_DEPENDENCY_ROOT}/cpktmisc/install/lib")
      list(APPEND paths "${AILO_DEPENDENCY_ROOT}/cpktmisc/install/lib")
    endif()
    if(DEFINED AILO_DEPENDENCY_ROOT AND EXISTS "${AILO_DEPENDENCY_ROOT}/lonejson/install/lib")
      list(APPEND paths "${AILO_DEPENDENCY_ROOT}/lonejson/install/lib")
    endif()
    if(DEFINED AILO_DEPENDENCY_ROOT AND EXISTS "${AILO_DEPENDENCY_ROOT}/pslog/install/lib")
      list(APPEND paths "${AILO_DEPENDENCY_ROOT}/pslog/install/lib")
    endif()
    target_link_options(${target} PRIVATE "-Wl,--dynamic-linker=${loader}" "-Wl,--disable-new-dtags")
    set_property(TARGET ${target} PROPERTY BUILD_RPATH "${paths}")
  endif()
endfunction()
include("${CMAKE_CURRENT_LIST_DIR}/AiloRuntime.cmake")
