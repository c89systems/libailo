function(ailo_c89_target target)
  target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:C>:-std=c89;-Wall;-Wextra;-Wpedantic;-pedantic-errors;-Werror>")
endfunction()

function(ailo_local_executable target)
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT CMAKE_CROSSCOMPILING)
    file(GLOB loaders "${CMAKE_SYSROOT}/lib/ld-linux*.so*" "${CMAKE_SYSROOT}/lib/ld-musl*.so*")
    list(LENGTH loaders count)
    if(NOT count EQUAL 1)
      message(FATAL_ERROR "Expected one Bootlin ELF loader: ${loaders}")
    endif()
    list(GET loaders 0 loader)
    target_link_options(${target} PRIVATE "-Wl,--dynamic-linker=${loader}" "-Wl,--disable-new-dtags")
    set_property(TARGET ${target} PROPERTY BUILD_RPATH "${CMAKE_SYSROOT}/lib;${CMAKE_SYSROOT}/usr/lib;${AILO_BOOTLIN_ROOT}/lib;${AILO_BOOTLIN_ROOT}/lib64")
  endif()
endfunction()
