cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/AiloArchive.cmake")
get_filename_component(ailo_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED AILO_DEPENDENCY_LOCK)
  set(AILO_DEPENDENCY_LOCK "${CMAKE_CURRENT_LIST_DIR}/dependencies.json")
endif()
file(READ "${AILO_DEPENDENCY_LOCK}" pins)
if(NOT AILO_TARGET_ID STREQUAL "host" AND NOT AILO_TARGET_ID MATCHES "^(x86_64|aarch64)-linux-(gnu|musl)$")
  message(FATAL_ERROR "Unsupported dependency target: ${AILO_TARGET_ID}")
endif()

function(ailo_prepare_dependency name output)
  if(NOT name MATCHES "^[a-z][a-z0-9-]*$")
    message(FATAL_ERROR "Invalid dependency name: ${name}")
  endif()
  string(JSON dep ERROR_VARIABLE error GET "${pins}" "${name}")
  if(error)
    message(FATAL_ERROR "No pinned dependency named ${name}: ${error}")
  endif()
  string(JSON assets ERROR_VARIABLE no_assets GET "${dep}" assets)
  if(no_assets)
    set(recipe "${dep}")
    set(sdk FALSE)
  else()
    if(AILO_TARGET_ID STREQUAL "host")
      message(FATAL_ERROR "Host dependency preparation accepts source archives only: ${name}")
    endif()
    string(JSON recipe ERROR_VARIABLE error GET "${assets}" "${AILO_TARGET_ID}")
    if(error)
      message(FATAL_ERROR "${name}: no pinned SDK for ${AILO_TARGET_ID}")
    endif()
    set(sdk TRUE)
  endif()
  string(JSON url GET "${recipe}" url)
  string(JSON sha GET "${recipe}" sha256)

  # Preserve compatible extraction contracts from the initial driver. The
  # recipe contains string-valued pins; canonicalization does not add a new
  # cache identity or invalidate an unchanged component.
  string(JSON members LENGTH "${recipe}")
  math(EXPR last "${members} - 1")
  set(canonical "{")
  set(separator "")
  foreach(index RANGE 0 ${last})
    string(JSON key MEMBER "${recipe}" ${index})
    string(JSON type TYPE "${recipe}" "${key}")
    if(NOT type STREQUAL "STRING")
      message(FATAL_ERROR "${name}: dependency recipe ${key} must be a string")
    endif()
    string(JSON value GET "${recipe}" "${key}")
    string(APPEND canonical "${separator}\"${key}\": \"${value}\"")
    set(separator ", ")
  endforeach()
  string(APPEND canonical "}")
  string(SHA256 identity "${canonical}")
  set(base "${ailo_root}/.cache/deps-build/${AILO_TARGET_ID}/${name}")
  set(install "${ailo_root}/.cache/deps/${AILO_TARGET_ID}/${name}/install")
  set(contract "${ailo_root}/.cache/dependency-contracts/${AILO_TARGET_ID}/${name}.txt")
  get_filename_component(contract_dir "${contract}" DIRECTORY)
  file(MAKE_DIRECTORY "${contract_dir}")
  file(LOCK "${contract}.lock" GUARD FUNCTION TIMEOUT 600)
  if(sdk)
    set(prepared "${install}")
    if(name STREQUAL "cpkt")
      set(required "${install}/lib/libcurl.a")
    elseif(name STREQUAL "cpktmisc")
      set(required "${install}/lib/libffi.a")
    elseif(name STREQUAL "lonejson")
      set(required "${install}/lib/liblonejson.a")
    elseif(name STREQUAL "pslog")
      set(required "${install}/lib/libpslog.a")
    elseif(name STREQUAL "lockdc")
      set(required "${install}/lib/liblockdc.a")
    elseif(name STREQUAL "liblql")
      set(required "${install}/lib/liblql.a")
    else()
      message(FATAL_ERROR "No SDK readiness contract for ${name}")
    endif()
  else()
    set(prepared "${base}/source")
    set(required "${prepared}/CMakeLists.txt")
    string(JSON build_system ERROR_VARIABLE no_build_system GET "${dep}" build_system)
    if(NOT no_build_system)
      if(build_system STREQUAL "meson")
        set(required "${prepared}/meson.build")
      elseif(NOT build_system STREQUAL "cmake")
        message(FATAL_ERROR "${name}: unsupported source build system ${build_system}")
      endif()
    endif()
    if(name STREQUAL "lua-pslog")
      set(required "${prepared}/include/pslog_lua.h")
    elseif(name STREQUAL "llvm-cmake")
      set(required "${prepared}/Modules/CMakePolicy.cmake")
    endif()
  endif()
  if(EXISTS "${contract}" AND EXISTS "${required}")
    file(READ "${contract}" previous)
    string(STRIP "${previous}" previous)
    if(previous STREQUAL identity)
      set(${output} "${prepared}" PARENT_SCOPE)
      return()
    endif()
  endif()

  ailo_acquire_verified_archive("${name}" "${url}" "${sha}" archive)
  string(RANDOM LENGTH 16 random)
  set(stage "${ailo_root}/build/deps/${name}-${AILO_TARGET_ID}-${random}")
  file(MAKE_DIRECTORY "${stage}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
    WORKING_DIRECTORY "${stage}" RESULT_VARIABLE result ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    file(REMOVE_RECURSE "${stage}")
    message(FATAL_ERROR "${name}: extraction failed: ${error}")
  endif()
  file(GLOB roots LIST_DIRECTORIES TRUE "${stage}/*")
  list(LENGTH roots count)
  if(NOT count EQUAL 1)
    file(REMOVE_RECURSE "${stage}")
    message(FATAL_ERROR "${name}: archive must contain one directory root")
  endif()
  list(GET roots 0 extracted)
  if(NOT IS_DIRECTORY "${extracted}")
    file(REMOVE_RECURSE "${stage}")
    message(FATAL_ERROR "${name}: archive root must be a directory")
  endif()
  # Delete only fixed, lifecycle-owned paths after verified extraction succeeds.
  file(REMOVE_RECURSE "${base}" "${install}")
  file(MAKE_DIRECTORY "${base}")
  get_filename_component(parent "${prepared}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  file(RENAME "${extracted}" "${prepared}")
  file(REMOVE_RECURSE "${stage}")
  if(NOT sdk)
    file(MAKE_DIRECTORY "${install}")
  endif()
  if(NOT EXISTS "${required}")
    message(FATAL_ERROR "${name}: prepared archive is missing ${required}")
  endif()
  file(WRITE "${contract}" "${identity}\n")
  set(${output} "${prepared}" PARENT_SCOPE)
endfunction()

if(DEFINED AILO_DEPENDENCY AND NOT AILO_DEPENDENCY STREQUAL "")
  set(components "${AILO_DEPENDENCY}")
else()
  string(JSON count LENGTH "${pins}")
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON component MEMBER "${pins}" ${index})
    list(APPEND components "${component}")
  endforeach()
endif()
foreach(component IN LISTS components)
  ailo_prepare_dependency("${component}" prepared)
  message(STATUS "${component}=${prepared}")
endforeach()
