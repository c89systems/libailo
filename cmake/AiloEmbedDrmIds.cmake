cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "AMDGPU ID generation requires INPUT and OUTPUT")
endif()
file(STRINGS "${INPUT}" lines ENCODING UTF-8)
set(version "")
set(entries "")
foreach(line IN LISTS lines)
  string(STRIP "${line}" line)
  if(line STREQUAL "" OR line MATCHES "^#")
    continue()
  endif()
  if(version STREQUAL "")
    if(NOT line STREQUAL "1.0.0")
      message(FATAL_ERROR "Unsupported AMDGPU IDs table version: ${line}")
    endif()
    set(version "${line}")
    continue()
  endif()
  if(NOT line MATCHES "^([0-9a-fA-F]+),[ \t]*([0-9a-fA-F]+),[ \t]*(.+)$")
    message(FATAL_ERROR "Invalid AMDGPU IDs row: ${line}")
  endif()
  set(device "${CMAKE_MATCH_1}")
  set(revision "${CMAKE_MATCH_2}")
  set(name "${CMAKE_MATCH_3}")
  string(LENGTH "${device}" device_length)
  string(LENGTH "${revision}" revision_length)
  if(device_length GREATER 4 OR revision_length GREATER 2)
    message(FATAL_ERROR "AMDGPU IDs row exceeds PCI device/revision range: ${line}")
  endif()
  string(REPLACE "\\" "\\\\" name "${name}")
  string(REPLACE "\"" "\\\"" name "${name}")
  string(APPEND entries "  {0x${device}, 0x${revision}, \"${name}\"},\n")
endforeach()
if(entries STREQUAL "")
  message(FATAL_ERROR "AMDGPU IDs table has no devices")
endif()
file(WRITE "${OUTPUT}"
  "/* Generated from pinned libdrm data/amdgpu.ids; libdrm MIT notices apply. */\n"
  "static const struct { uint32_t device; uint32_t revision; const char *name; }\n"
  "ailo_amdgpu_ids[] = {\n${entries}};\n")
