cmake_minimum_required(VERSION 3.24)
file(READ "${INPUT}" bytes HEX)
string(LENGTH "${bytes}" length)
math(EXPR remainder "${length} % 8")
if(length LESS 40 OR remainder OR NOT bytes MATCHES "^03022307")
  message(FATAL_ERROR "Expected a complete little-endian SPIR-V module")
endif()
string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," words "${bytes}")
file(WRITE "${OUTPUT}" "// Generated from the shared-memory regression shader.\n#include <cstdint>\nstatic const std::uint32_t shared_shader[] = {${words}};\n")
