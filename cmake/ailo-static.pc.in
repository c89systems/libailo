prefix=${pcfiledir}/../..
includedir=${prefix}/include

Name: ailo-static
Description: Strict C89 local GGUF inference library with separate static link closure
Version: @PROJECT_VERSION@
Requires.private: lockdc = 0.21.0 libcurl >= 8.22.0 libcrypto >= 3.6.5 lonejson = 0.45.0 libffi = 3.8.0 pslog = 0.12.0
Libs: -L${prefix}/lib -l:libailo.a
Libs.private: -static-libstdc++ -static-libgcc -L${prefix}/lib/ailo/native -L${prefix}/lib/ailo/runtime -Wl,--start-group @AILO_NATIVE_PC@ @AILO_RUNTIME_PC@ @AILO_VULKAN_PC@ -Wl,--end-group -pthread -lm
Cflags: -I${includedir}
