function(ailo_native_runtime output_loader output_paths)
  file(GLOB loaders "${CMAKE_SYSROOT}/lib/ld-linux*.so*" "${CMAKE_SYSROOT}/lib/ld-musl*.so*")
  list(LENGTH loaders count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one Bootlin ELF loader: ${loaders}")
  endif()
  list(GET loaders 0 loader)
  set(paths "${CMAKE_SYSROOT}/lib" "${CMAKE_SYSROOT}/usr/lib" "${CMAKE_SYSROOT}/usr/lib64")
  foreach(library libstdc++.so.6 libgcc_s.so.1)
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" "-print-file-name=${library}"
      RESULT_VARIABLE result OUTPUT_VARIABLE file OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0 OR NOT EXISTS "${file}")
      message(FATAL_ERROR "The selected collection has no ${library}: ${file}")
    endif()
    file(REAL_PATH "${file}" file)
    string(FIND "${file}" "${AILO_BOOTLIN_ROOT}/" inside)
    if(NOT inside EQUAL 0)
      message(FATAL_ERROR "Compiler runtime escaped the selected Bootlin collection: ${file}")
    endif()
    get_filename_component(directory "${file}" DIRECTORY)
    list(APPEND paths "${directory}")
  endforeach()
  list(REMOVE_DUPLICATES paths)
  set(${output_loader} "${loader}" PARENT_SCOPE)
  set(${output_paths} "${paths}" PARENT_SCOPE)
endfunction()
