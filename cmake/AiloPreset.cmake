cmake_minimum_required(VERSION 3.24)
get_filename_component(ailo_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${ailo_root}/CMakePresets.json" presets)
if(NOT AILO_PRESET MATCHES "^[a-zA-Z0-9-]+$")
  message(FATAL_ERROR "Invalid preset name: ${AILO_PRESET}")
endif()

function(ailo_resolve_preset name trail output)
  set(requested FALSE)
  if("${trail}" STREQUAL "")
    set(requested TRUE)
  endif()
  if(name IN_LIST trail)
    message(FATAL_ERROR "Preset inheritance cycle at ${name}")
  endif()
  list(APPEND trail "${name}")
  string(JSON count LENGTH "${presets}" configurePresets)
  math(EXPR last "${count} - 1")
  set(found FALSE)
  foreach(index RANGE 0 ${last})
    string(JSON entry GET "${presets}" configurePresets ${index})
    string(JSON candidate GET "${entry}" name)
    if(candidate STREQUAL name)
      set(found TRUE)
      break()
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "No configure preset named ${name}; use cmake --list-presets")
  endif()
  string(JSON hidden ERROR_VARIABLE missing GET "${entry}" hidden)
  if(requested AND NOT missing AND hidden)
    message(FATAL_ERROR "Preset ${name} is hidden and cannot be configured")
  endif()
  set(merged "{}")
  string(JSON type ERROR_VARIABLE missing TYPE "${entry}" inherits)
  if(NOT missing)
    if(type STREQUAL "ARRAY")
      string(JSON length LENGTH "${entry}" inherits)
      math(EXPR final "${length} - 1")
      foreach(i RANGE 0 ${final})
        string(JSON parent GET "${entry}" inherits ${i})
        list(APPEND parents "${parent}")
      endforeach()
      # CMake gives earlier inherited presets precedence over later ones.
      list(REVERSE parents)
    else()
      string(JSON parents GET "${entry}" inherits)
    endif()
    foreach(parent IN LISTS parents)
      ailo_resolve_preset("${parent}" "${trail}" inherited)
      string(JSON length LENGTH "${inherited}")
      if(length GREATER 0)
        math(EXPR final "${length} - 1")
        foreach(i RANGE 0 ${final})
          string(JSON key MEMBER "${inherited}" ${i})
          string(JSON value GET "${inherited}" "${key}")
          string(JSON merged SET "${merged}" "${key}" "\"${value}\"")
        endforeach()
      endif()
    endforeach()
  endif()
  foreach(key AILO_TARGET_ID AILO_VULKAN)
    string(JSON value ERROR_VARIABLE missing GET "${entry}" cacheVariables "${key}")
    if(NOT missing)
      string(JSON merged SET "${merged}" "${key}" "\"${value}\"")
    endif()
  endforeach()
  set(${output} "${merged}" PARENT_SCOPE)
endfunction()

ailo_resolve_preset("${AILO_PRESET}" "" resolved)
string(JSON target ERROR_VARIABLE missing GET "${resolved}" AILO_TARGET_ID)
if(missing)
  set(target x86_64-linux-gnu)
endif()
string(JSON vulkan ERROR_VARIABLE missing GET "${resolved}" AILO_VULKAN)
if(missing)
  set(vulkan ON)
endif()
file(WRITE "${AILO_PRESET_RESULT}" "target=${target}\nvulkan=${vulkan}\n")
