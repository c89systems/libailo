cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/AiloToolchain.cmake")
find_program(AILO_PKG_CONFIG NAMES pkg-config pkgconf REQUIRED)

# Meson machine files use quoted strings, not shell fragments. The compiler's
# sysroot owns platform headers/libraries; pkg-config sees only target prefixes.
function(meson_string input output)
  string(REPLACE "\\" "\\\\" value "${input}")
  string(REPLACE "'" "\\'" value "${value}")
  set(${output} "'${value}'" PARENT_SCOPE)
endfunction()
foreach(pair "MESON_CC;CMAKE_C_COMPILER" "MESON_CXX;CMAKE_CXX_COMPILER"
             "MESON_AR;CMAKE_AR" "MESON_STRIP;CMAKE_STRIP"
             "MESON_PKG_CONFIG;AILO_PKG_CONFIG")
  list(GET pair 0 destination)
  list(GET pair 1 source)
  meson_string("${${source}}" ${destination})
endforeach()
meson_string("--sysroot=${CMAKE_SYSROOT}" MESON_SYSROOT_ARG)
meson_string("${CMAKE_SYSROOT}" MESON_SYSROOT)
meson_string("-ffile-prefix-map=${AILO_SOURCE_ROOT}/.cache=ailo-dependencies" MESON_PREFIX_ARG)
if(AILO_TARGET_ID MATCHES "^x86_64-")
  set(MESON_CPU x86_64)
else()
  set(MESON_CPU aarch64)
endif()
set(MESON_PKG_DIRS "")
foreach(component cpkt cpktmisc lonejson pslog vulkan-headers spirv-headers libdrm mesa)
  foreach(suffix lib/pkgconfig share/pkgconfig)
    meson_string("${AILO_SDK_ROOT}/${component}/install/${suffix}" directory)
    string(APPEND MESON_PKG_DIRS "${directory}, ")
  endforeach()
endforeach()
set(MESON_CMAKE_ROOTS "")
foreach(path IN LISTS CMAKE_FIND_ROOT_PATH)
  meson_string("${path}" directory)
  string(APPEND MESON_CMAKE_ROOTS "${directory}, ")
endforeach()
set(output "${AILO_SOURCE_ROOT}/build/deps/${AILO_TARGET_ID}/meson.ini")
get_filename_component(parent "${output}" DIRECTORY)
file(MAKE_DIRECTORY "${parent}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/meson-cross.ini.in" "${output}" @ONLY)
message(STATUS "Meson target toolchain: ${output}")
