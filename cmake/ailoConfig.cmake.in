@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(ailo_VERSION "@PROJECT_VERSION@")
set(ailo_TARGET_ID "@AILO_TARGET_ID@")
set(ailo_VULKAN "@AILO_VULKAN@")
set(_ailo_prefix "${PACKAGE_PREFIX_DIR}")
set(ailo_static_FOUND "@AILO_BUILD_STATIC@")
set(ailo_shared_FOUND "@AILO_BUILD_SHARED@")
set(_ailo_want_static "@AILO_BUILD_STATIC@")
if(ailo_FIND_COMPONENTS AND NOT "static" IN_LIST ailo_FIND_COMPONENTS)
  set(_ailo_want_static FALSE)
endif()

# Consumers supply the released c.pkt.systems SDK through CMAKE_PREFIX_PATH or
# ailo_EXTERNAL_ROOT. No source/build/toolchain path is embedded here.
if(DEFINED ailo_EXTERNAL_ROOT)
  set(CURL_DIR "${ailo_EXTERNAL_ROOT}/lib/cmake/CURL")
endif()
find_dependency(Threads REQUIRED)
if(_ailo_want_static)
  find_package(CURL 8.22 CONFIG QUIET)
  if(NOT CURL_FOUND OR NOT TARGET CURL::libcurl OR NOT TARGET OpenSSL::Crypto)
    set(ailo_FOUND FALSE)
    set(ailo_NOT_FOUND_MESSAGE "ailo::static requires c.pkt.systems v0.11.0 curl/OpenSSL targets. Set ailo_EXTERNAL_ROOT or CMAKE_PREFIX_PATH to the ${ailo_TARGET_ID} SDK described by share/ailo/dependencies.json.")
    return()
  endif()
endif()
set(PACKAGE_PREFIX_DIR "${_ailo_prefix}")
function(_ailo_archive name file)
  set_and_check(location "${PACKAGE_PREFIX_DIR}/${file}")
  if(NOT TARGET ailo::${name})
    add_library(ailo::${name} STATIC IMPORTED)
    set_target_properties(ailo::${name} PROPERTIES IMPORTED_LOCATION "${location}" IMPORTED_LINK_INTERFACE_LANGUAGES C)
  endif()
endfunction()
set(_ailo_native_names "@AILO_NATIVE_NAMES@")
set(_ailo_native_targets "")
foreach(name IN LISTS _ailo_native_names)
  string(REPLACE "-" "_" tag "${name}")
  _ailo_archive("native_${tag}" "lib/ailo/native/lib${name}.a")
  list(APPEND _ailo_native_targets "ailo::native_${tag}")
endforeach()
set(_ailo_runtime_targets "")
foreach(pair "stdcxx;libstdc++.a" "gcc_eh;libgcc_eh.a" "gcc;libgcc.a")
  list(GET pair 0 name)
  list(GET pair 1 file)
  _ailo_archive("runtime_${name}" "lib/ailo/runtime/${file}")
  list(APPEND _ailo_runtime_targets "ailo::runtime_${name}")
endforeach()
set(_ailo_vulkan "")
if(ailo_VULKAN)
  set_and_check(_ailo_vulkan_location "${PACKAGE_PREFIX_DIR}/lib/ailo/native/libvulkan.so")
  if(NOT TARGET ailo::native_vulkan_loader)
    add_library(ailo::native_vulkan_loader SHARED IMPORTED)
    set_target_properties(ailo::native_vulkan_loader PROPERTIES IMPORTED_LOCATION "${_ailo_vulkan_location}")
  endif()
  set(_ailo_vulkan ailo::native_vulkan_loader)
endif()
if(_ailo_want_static AND NOT TARGET ailo::static)
  set_and_check(_ailo_archive_location "${PACKAGE_PREFIX_DIR}/lib/libailo.a")
  add_library(ailo::static STATIC IMPORTED)
  set_target_properties(ailo::static PROPERTIES IMPORTED_LOCATION "${_ailo_archive_location}" IMPORTED_LINK_INTERFACE_LANGUAGES C INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include")
  # The facade archive precedes this group. Repeated archive dependencies within
  # native/mtmd and the C++ runtime resolve without consumer workaround flags.
  set_property(TARGET ailo::static PROPERTY INTERFACE_LINK_LIBRARIES
    "-Wl,--start-group;${_ailo_native_targets};CURL::libcurl;OpenSSL::Crypto;${_ailo_runtime_targets};-Wl,--end-group;${_ailo_vulkan};Threads::Threads;m;${CMAKE_DL_LIBS}")
  set_property(TARGET ailo::static PROPERTY INTERFACE_LINK_OPTIONS "$<$<LINK_LANGUAGE:CXX>:-static-libstdc++;-static-libgcc>")
endif()
if(@AILO_BUILD_SHARED@ AND NOT TARGET ailo::shared)
  set_and_check(_ailo_library_location "${PACKAGE_PREFIX_DIR}/lib/libailo.so.0")
  add_library(ailo::shared SHARED IMPORTED)
  set_target_properties(ailo::shared PROPERTIES IMPORTED_LOCATION "${_ailo_library_location}" INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include")
endif()
check_required_components(ailo)
