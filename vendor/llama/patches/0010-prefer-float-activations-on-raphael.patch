+// Keep F16 weight/KV storage, but prefer F32 arithmetic on the qualified APU.
+static bool ggml_vk_prefers_f32(const vk::PhysicalDevice& physical_device) {
+    const vk::PhysicalDeviceProperties props = physical_device.getProperties();
+    return props.vendorID == VK_VENDOR_ID_AMD && props.deviceID == 0x164e;
+}
+
+#if defined(GGML_VULKAN_INTEGER_DOT_GLSLC_SUPPORT)
+static bool ggml_vk_disable_integer_dot_product(const vk::PhysicalDevice& physical_device) {
+    if (getenv("GGML_VK_DISABLE_INTEGER_DOT_PRODUCT")) {
+        return true;
+    }
+    // libailo's Raphael profile preserves floating-point activations. The Q8_1
+    // path changes trained logits beyond this profile's accepted error bounds.
+    return ggml_vk_prefers_f32(physical_device);
+}
+#endif
