+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Private context; the public global logging hooks remain fallbacks. */
+struct ggml_log_scope { ggml_log_callback callback; void * user_data; };
+GGML_API struct ggml_log_scope ggml_log_scope_get(void);
+GGML_API void ggml_log_scope_set(struct ggml_log_scope scope);
+#ifdef __cplusplus
+}
+struct ggml_log_scope_guard {
+    ggml_log_scope previous;
+    explicit ggml_log_scope_guard(ggml_log_scope scope) : previous(ggml_log_scope_get()) { ggml_log_scope_set(scope); }
+    ~ggml_log_scope_guard() { ggml_log_scope_set(previous); }
+    ggml_log_scope_guard(const ggml_log_scope_guard &) = delete;
+    ggml_log_scope_guard & operator=(const ggml_log_scope_guard &) = delete;
+};
+#endif
+#endif
