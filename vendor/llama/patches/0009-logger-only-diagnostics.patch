+int ggml_log_fprintf(enum ggml_log_level level, FILE *stream, const char *format, ...) {
+    va_list args;
+    va_start(args, format);
+    int result;
+    if (stream != stdout && stream != stderr) {
+        result = vfprintf(stream, format, args);
+    } else {
+        va_list count;
+        va_copy(count, args);
+        result = vsnprintf(NULL, 0, format, count);
+        va_end(count);
+        if (result >= 0) ggml_log_internal_v(level, format, args);
+    }
+    va_end(args);
