+                                      level == 1 ? GGML_LOG_LEVEL_WARN : GGML_LOG_LEVEL_TRACE;
+    ggml_log_internal(mapped, "%s: ", component);
+    ggml_log_internal_v(GGML_LOG_LEVEL_CONT, format, args);
 }
 
