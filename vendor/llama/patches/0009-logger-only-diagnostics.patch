--- a/ggml/src/ggml-library-log.h
+++ b/ggml/src/ggml-library-log.h
@@ -0,0 +1,49 @@
+#ifndef GGML_LIBRARY_LOG_H
+#define GGML_LIBRARY_LOG_H
+#include "ggml.h"
+#include <stdio.h>
+#include <stdarg.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+GGML_API void ggml_log_internal(enum ggml_log_level, const char *, ...);
+GGML_API int ggml_log_fprintf(enum ggml_log_level, FILE *, const char *, ...);
+GGML_API int ggml_log_printf(enum ggml_log_level, const char *, ...);
+GGML_API void ggml_library_driver_log(int, const char *, const char *, va_list);
+#ifdef __cplusplus
+}
+#include <ostream>
+#include <streambuf>
+#include <climits>
+// Stack-owned stream: forward each borrowed fragment immediately. No TLS
+// destructor, retained logger, unbounded buffer or process-global stream swap.
+class ggml_log_stream {
+    class buffer : public std::streambuf {
+        ggml_log_level level;
+        std::streamsize xsputn(const char *p, std::streamsize n) override {
+            const auto total = n;
+            while (n > 0) {
+                const int count = n > INT_MAX ? INT_MAX : int(n);
+                ggml_log_internal(level, "%.*s", count, p);
+                p += count;
+                n -= count;
+            }
+            return total;
+        }
+        int_type overflow(int_type c) override {
+            if (!traits_type::eq_int_type(c, traits_type::eof())) {
+                const char value = traits_type::to_char_type(c);
+                xsputn(&value, 1);
+            }
+            return traits_type::not_eof(c);
+        }
+    public:
+        explicit buffer(ggml_log_level value) : level(value) {}
+    } output;
+    std::ostream target;
+public:
+    explicit ggml_log_stream(ggml_log_level level) : output(level), target(&output) {}
+    std::ostream &stream() { return target; }
+};
+#endif
+#endif
