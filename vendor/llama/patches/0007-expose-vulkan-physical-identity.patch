+// Private libailo query: physical identity without creating a logical device.
+// UUIDs are raw 16-byte values; numbers are vendor, device, driver and flags.
+static bool ggml_backend_vk_ailo_device_identity(ggml_backend_dev_t dev,
+        unsigned char * uuid, unsigned char * driver_uuid, uint32_t * numbers) {
+    if (!dev || !uuid || !driver_uuid || !numbers) {
+        return false;
+    }
+    try {
+        auto * ctx = static_cast<ggml_backend_vk_device_context *>(dev->context);
+        vk::PhysicalDevice physical = vk_instance.instance.enumeratePhysicalDevices()[vk_instance.device_indices[ctx->device]];
+        vk::PhysicalDeviceIDProperties ids;
+        vk::PhysicalDeviceDriverProperties driver;
+        vk::PhysicalDeviceProperties2 props;
+        props.pNext = &driver;
+        driver.pNext = &ids;
+        physical.getProperties2(&props);
+        std::memcpy(uuid, ids.deviceUUID.data(), VK_UUID_SIZE);
+        std::memcpy(driver_uuid, ids.driverUUID.data(), VK_UUID_SIZE);
+        numbers[0] = props.properties.vendorID;
+        numbers[1] = props.properties.deviceID;
+        numbers[2] = static_cast<uint32_t>(driver.driverID);
+        numbers[3] = vk_instance.device_supports_membudget[ctx->device] ? 1 : 0;
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
+
+static void * ggml_backend_vk_reg_get_proc_address(ggml_backend_reg_t reg, const char * name) {
+    UNUSED(reg);
+    if (strcmp(name, "ailo_vk_device_identity") == 0) {
+        return reinterpret_cast<void *>(ggml_backend_vk_ailo_device_identity);
+    }
+    return nullptr;
+}
