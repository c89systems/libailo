--- a/drm-library-log.h
+++ b/drm-library-log.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef DRM_LIBRARY_LOG_H
+#define DRM_LIBRARY_LOG_H
+#include <stdio.h>
+#include <stdarg.h>
+extern void ggml_library_driver_log(int, const char *, const char *, va_list) __attribute__((weak));
+static inline int drm_library_vfprintf(int level, FILE *stream, const char *format, va_list args)
+{
+    if (stream != stdout && stream != stderr) return vfprintf(stream, format, args);
+    va_list copy;
+    va_copy(copy,args);
+    int result=vsnprintf(NULL,0,format,copy);
+    va_end(copy);
+    if (result>=0 && ggml_library_driver_log) ggml_library_driver_log(level,"drm",format,args);
+    return result;
+}
+static inline int drm_library_fprintf(int level, FILE *stream, const char *format, ...)
+{
+    va_list args;
+    va_start(args,format);
+    int result=drm_library_vfprintf(level,stream,format,args);
+    va_end(args);
+    return result;
+}
+static inline int drm_library_printf(int level, const char *format, ...)
+{
+    va_list args;
+    va_start(args,format);
+    int result=drm_library_vfprintf(level,stdout,format,args);
+    va_end(args);
+    return result;
+}
+#endif
