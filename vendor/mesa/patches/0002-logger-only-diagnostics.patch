+/* Private static-driver logging bridge. No process-global stream replacement.
+ * Explicit FILE output remains real stdio; diagnostic standard streams do not.
+ * The weak receiver is absent in standalone driver-only consumers: quiet then.
+ */
+extern void ggml_library_driver_log(int, const char *, const char *, va_list) __attribute__((weak));
+int mesa_library_vfprintf(int level, FILE *stream, const char *format, va_list args)
+{
+   if (stream != stdout && stream != stderr) return vfprintf(stream, format, args);
+   va_list count;
+   va_copy(count,args);
+   int result=vsnprintf(NULL,0,format,count);
+   va_end(count);
+   if(result>=0 && ggml_library_driver_log) ggml_library_driver_log(level,"mesa",format,args);
+   return result;
+}
+int mesa_library_fprintf(int level, FILE *stream, const char *format, ...)
+{
+   va_list args; va_start(args,format);
+   int result=mesa_library_vfprintf(level,stream,format,args);
+   va_end(args); return result;
+}
+int mesa_library_printf(int level, const char *format, ...)
+{
+   va_list args; va_start(args,format);
+   int result=mesa_library_vfprintf(level,stdout,format,args);
+   va_end(args); return result;
+}
+int mesa_library_fputs(int level, const char *text, FILE *stream)
+{
+   if(stream!=stdout && stream!=stderr) return fputs(text,stream);
+   return mesa_library_fprintf(level,stream,"%s",text);
+}
+int mesa_library_fputc(int level, int ch, FILE *stream)
+{
+   if(stream!=stdout && stream!=stderr) return fputc(ch,stream);
+   return mesa_library_fprintf(level,stream,"%c",ch)<0 ? EOF : (unsigned char)ch;
+}
+int mesa_library_puts(int level, const char *text) { return mesa_library_printf(level,"%s\n",text); }
+int mesa_library_putchar(int level, int ch) { return mesa_library_fputc(level,ch,stdout); }
+void mesa_library_perror(int level, const char *prefix)
+{
+   int saved=errno;
+   mesa_library_fprintf(level,stderr,"%s%s%s\n",prefix?prefix:"",prefix&&*prefix?": ":"",strerror(saved));
+   errno=saved;
+}
