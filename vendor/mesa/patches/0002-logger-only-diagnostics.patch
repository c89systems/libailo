--- a/src/util/library-log-data.h
+++ b/src/util/library-log-data.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef MESA_LIBRARY_LOG_DATA_H
+#define MESA_LIBRARY_LOG_DATA_H
+#include "library-log.h"
+#include <stdint.h>
+#include <errno.h>
+/* Bounded diagnostic fragments, including escaped embedded NUL bytes.
+ * Caller-directed file output retains fwrite's binary semantics. */
+static inline size_t mesa_library_fwrite(int level, const void *data, size_t size, size_t count, FILE *stream)
+{
+   if (stream != stdout && stream != stderr) return fwrite(data,size,count,stream);
+   if (!size || !count) return 0;
+   if (count > SIZE_MAX / size) { errno=EOVERFLOW; return 0; }
+   const unsigned char *p=(const unsigned char *)data;
+   size_t left=size*count;
+   while (left) {
+      char text[512];
+      size_t used=0;
+      while (left && used<=sizeof(text)-4) {
+         unsigned char ch=*p++; --left;
+         if (ch) text[used++]=(char)ch;
+         else { text[used++]='\\'; text[used++]='x'; text[used++]='0'; text[used++]='0'; }
+      }
+      if (mesa_library_fprintf(level,stream,"%.*s",(int)used,text)<0)
+         return (size*count-left)/size;
+   }
+   return count;
+}
+#endif
