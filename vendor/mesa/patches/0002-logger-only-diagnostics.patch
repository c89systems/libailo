+#include <climits>
+class mesa_library_stream {
+   class buffer : public std::streambuf {
+      int level;
+      std::streamsize xsputn(const char *p, std::streamsize n) override {
+         auto total=n;
+         while(n>0) {
+            int count=n>INT_MAX ? INT_MAX : int(n);
+            mesa_library_printf(level, "%.*s", count, p);
+            p+=count; n-=count;
+         }
+         return total;
+      }
+      int_type overflow(int_type c) override {
+         if(!traits_type::eq_int_type(c,traits_type::eof())) {
+            char ch=traits_type::to_char_type(c); xsputn(&ch,1);
+         }
+         return traits_type::not_eof(c);
+      }
+   public:
+      explicit buffer(int l):level(l){}
+   } output;
+   std::ostream target;
+public:
+   explicit mesa_library_stream(int level):output(level),target(&output){}
+   std::ostream &stream(){return target;}
+};
+#endif
