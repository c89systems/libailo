execute_process(COMMAND "${READELF}" -d "${MODULE}" RESULT_VARIABLE result OUTPUT_VARIABLE dynamic)
if(NOT result EQUAL 0 OR NOT dynamic MATCHES "NEEDED[^\n]*libailo.so" OR dynamic MATCHES "(RUNPATH|RPATH)")
  message(FATAL_ERROR "Facade must import the public shared ABI without local runtime paths: ${dynamic}")
endif()
execute_process(COMMAND "${NM}" -D --defined-only "${MODULE}" RESULT_VARIABLE result OUTPUT_VARIABLE defined)
string(REGEX REPLACE "[^\n]*[ \t]luaopen_ailo_core\n" "" remaining "${defined}")
string(STRIP "${remaining}" remaining)
if(NOT result EQUAL 0 OR NOT remaining STREQUAL "" OR NOT defined MATCHES "luaopen_ailo_core")
  message(FATAL_ERROR "Unexpected facade exports: ${defined}")
endif()
execute_process(COMMAND "${NM}" -D --undefined-only "${MODULE}" RESULT_VARIABLE result OUTPUT_VARIABLE undefined)
if(NOT result EQUAL 0 OR undefined MATCHES "[ \t](llama_|ggml_|mtmd_|_Z)" OR NOT undefined MATCHES "ailo_client_generate")
  message(FATAL_ERROR "Private runtime leaked across facade ABI: ${undefined}")
endif()
