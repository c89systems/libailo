rockspec_format = "3.0"
package = "lua-ailo"
version = "@VERSION@-1"
source = {
  url = "https://github.com/c89systems/libailo/releases/download/v@VERSION@/lua-ailo-@VERSION@.tar.gz",
  dir = "lua-ailo-@VERSION@",
}
description = {
  summary = "Streaming Lua receiver facade for libailo",
  homepage = "https://github.com/c89systems/libailo",
  license = "MIT",
}
dependencies = { "lua >= 5.5, < 5.6", "lua-pslog == 0.12.0-1" }
external_dependencies = {
  AILO = { header = "ailo/client.h", library = "ailo" },
  PSLOG = { header = "pslog.h", library = "pslog" },
  PSLOG_LUA = { header = "pslog_lua.h" },
  CPKTLUA = { header = "lua.h", library = "lua" },
}
build = {
  type = "cmake",
  variables = {
    CMAKE_BUILD_TYPE = "Release",
    CMAKE_INSTALL_PREFIX = "$(PREFIX)",
    CMAKE_PREFIX_PATH = "$(AILO_DIR);$(PSLOG_DIR);$(CPKTLUA_DIR)",
    PSLOG_LUA_INCLUDE_DIR = "$(PSLOG_LUA_INCDIR)",
    AILO_LUA_TESTS = "OFF",
    AILO_LUA_CMODULE_DIR = "$(LIBDIR)",
    AILO_LUA_MODULE_DIR = "$(LUADIR)",
  },
}
